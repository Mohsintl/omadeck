[Unit]
Description=OmaDeck — phone remote and voice bridge
Documentation=https://github.com/Mohsintl/omadeck
PartOf=graphical-session.target
After=graphical-session.target
# The bridge is useful without the voice daemon: the page still loads and
# reports "not running". It is more useful with it, so try to keep both up.
Wants=omarchy-voice.service

[Service]
Type=simple
ExecStart=%h/.local/share/omarchy-voice/bin/omarchy-voice mobile
# Same key file as the daemon: `omadeck mobile` from a terminal cannot
# see a key exported in your shell once it is started by systemd.
EnvironmentFile=-%h/.config/omarchy-voice/env
Restart=on-failure
RestartSec=3
ProtectSystem=strict
ReadWritePaths=-%h/.config/omarchy-voice -%h/.local/share/omarchy-voice -%h/.local/state/omarchy-voice -%h/.cache/omarchy-voice /tmp
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
NoNewPrivileges=true

[Install]
WantedBy=graphical-session.target
